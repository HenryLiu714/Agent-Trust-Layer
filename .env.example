# Copy to .env, edit, then `source .env`. Each line uses `export` so the values reach
# the irimi process. irimi reads only real environment variables; it never loads this file.

# irimi

# Root of irimi's state: the CA (`ca/`), the redaction key (`redact.key`), the trace store
# (`store/`) and an optional `maps.yaml` of answer targets. Default: ~/.irimi
# export IRIMI_HOME=~/.irimi

# Where runs are stored, when --store is not given. Default: $IRIMI_HOME/store
# export IRIMI_STORE=~/.irimi/store

# A label for the agent's version, stored with each run so `irimi compare` and `irimi replay`
# can show which version made it. Set it in the agent's environment.
# export IRIMI_AGENT_VERSION=1.4.0

# The examples

# Stripe test-mode secret key. Every example refuses a key that does not start with sk_test_.
# irimi itself never reads this.
# export STRIPE_API_KEY=sk_test_...

# Anthropic API key and model, for examples/replay. The model defaults to claude-opus-5-5.
# export ANTHROPIC_API_KEY=sk-ant-...
# export ANTHROPIC_MODEL=claude-opus-5-5
