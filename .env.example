# Copy to .env, edit, then `source .env`. Each line uses `export` so the values reach
# the irimi process. irimi reads only real environment variables; it never loads this file.

# Root directory for irimi state (CA now; maps and traces in later versions).
# Default: ~/.irimi
# export IRIMI_HOME=~/.irimi

# Stripe TEST-mode secret key for examples/refund_agent. The example refuses anything that does
# not start with sk_test_. irimi itself never reads this.
# export STRIPE_API_KEY=sk_test_...

# Optional: the refund agent also posts to Slack when both of these are set.
# export SLACK_BOT_TOKEN=xoxb-...
# export SLACK_CHANNEL=C0123456789
